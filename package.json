{
  "name": "synoptic-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-view markdown editing core: one document, many synchronized views, on CodeMirror 6.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cm": {
      "types": "./src/cm.ts",
      "import": "./dist/cm.js",
      "default": "./dist/cm.js"
    },
    "./debug": {
      "types": "./src/debug.ts",
      "import": "./dist/debug.js",
      "default": "./dist/debug.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SPEC.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/theme.css','dist/theme.css')\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:behaviour": "playwright test --pass-with-no-tests",
    "spike:phase0:build": "esbuild spikes/phase-0/main.ts --bundle --outfile=spikes/phase-0/dist/bundle.js --format=iife --platform=browser",
    "spike:phase0": "npm run spike:phase0:build && npx --yes serve spikes/phase-0 -l 4174",
    "spike:heading-widgets:build": "esbuild spikes/heading-widgets/main.ts --bundle --outfile=spikes/heading-widgets/dist/bundle.js --format=iife --platform=browser",
    "spike:heading-widgets": "npm run spike:heading-widgets:build && npx --yes serve spikes/heading-widgets -l 4176",
    "harness:build": "esbuild harness/main.ts --bundle --outfile=harness/dist/bundle.js --format=iife --platform=browser",
    "harness": "npm run harness:build && npx --yes serve harness -l 4173",
    "example:host:build": "cp src/theme.css examples/host/theme.css && esbuild examples/host/main.ts --bundle --outfile=examples/host/dist/bundle.js --format=iife --platform=browser",
    "example:host": "npm run example:host:build && npx --yes serve examples/host -l 4175",
    "check:core-purity": "node scripts/check-core-purity.mjs",
    "check:no-waiting": "node scripts/check-no-waiting.mjs",
    "check:rules-covered": "node scripts/check-rules-covered.mjs",
    "check:export-surface": "node scripts/check-export-surface.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:core-purity && npm run check:no-waiting && npm run check:rules-covered && npm run check:export-surface && npm run test:unit && npm run test:behaviour"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "yaml": "^2.9.0"
  }
}
